# Application
APP_NAME=Research RAG Assistant
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Paths (relative to project root)
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed

# Gradio
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
API_BASE_URL=http://127.0.0.1:8000

# OpenAI (Phase 1B)
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=256

# Qdrant (Phase 1B)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=research_chunks
VECTOR_SIZE=1536

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNKER_MODE=structure

# Phase 3B — enrichment & structure
ENRICHMENT_ENABLED=true
ENRICHMENT_BATCH_SIZE=8
PARENT_EXPAND_ENABLED=true
PARENT_MAX_CHARS=4000

# Phase 3D — coverage verify & answer validation
COVERAGE_VERIFY_ENABLED=true
COVERAGE_MAX_ROUNDS=1
ANSWER_VALIDATION_ENABLED=true

# OCR fallback (requires system `tesseract`)
OCR_ENABLED=true
OCR_MIN_CHAR_COUNT=50

# Phase 2 — chat / ask
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=1024
GENERATION_TEMPERATURE=0
RETRIEVAL_K=20
FINAL_K=5
HYBRID_ENABLED=true
RRF_K=60
RERANK_ENABLED=true
COHERE_API_KEY=your-cohere-key-here
RERANK_MODEL=rerank-v3.5

# Phase 3A — recall / coverage retrieval
QUERY_CLASSIFICATION_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_MAX=8
COVERAGE_RETRIEVAL_K=40
COVERAGE_FINAL_K=12
COVERAGE_PER_QUERY_LIMIT=15

# DocMind Backend — MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=docmind

# DocMind Backend — JWT Authentication
JWT_SECRET=your-secret-key-min-32-characters-long-must-set
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-must-set
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# DocMind Backend — Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# DocMind Backend — Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@docmind.ai
FRONTEND_URL=http://localhost:3000

# DocMind Backend — File Upload
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=200
UPLOAD_DIR=data/raw

# DocMind Backend — Rate Limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_UPLOAD=10/hour
